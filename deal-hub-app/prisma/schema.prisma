// Starwell Deal Hub — data model (PRD FINAL v3, §G + Part I-A).
// SQLite for local dev; schema is Postgres-compatible (swap provider + DATABASE_URL
// for the move — the job queue and document volume are the likely triggers, §H).
// Enum-like fields are String with the allowed values in a comment, so the same
// schema runs on SQLite (no native enums) and Postgres unchanged.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String   @default("Full") // Full | Deal-scoped | Read-only  (Part II §H)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  scores    ScoreEntry[]
}

// ---- Module A: the deal (canonical Target record, Part I-A §5.1) ----
model Deal {
  id            String   @id @default(cuid())
  projectName   String
  status        String   @default("Underwriting") // Underwriting|Call scheduled|IC|Approved|Pass|Hold|Lost|Closed|LOI drafted|LOI signed|Exclusivity|Definitive / SPA|Earnout period
  dealLead      String?
  priority      String?  // High|Medium|Low
  dealType      String?  // Value|Roll-up|Growth
  industry      String?  @default("IT Services")
  subIndustry   String?
  currency      String   @default("USD")
  jurisdiction  String   @default("US") // US | IL (Part II jurisdiction packs)
  driveFolderUrl String?
  businessProfile String?
  nextSteps     String?
  passReason    String?
  dateOfEntry   DateTime @default(now())
  // headline sourced values (every figure also lives in ProposedValue history)
  revenueM      Float?
  ebitdaM       Float?
  sdeM          Float?
  evM           Float?   // enterprise value / TEV
  valuationBasis String? // stamped on every multiple (Global invariant #4)
  score         Float?
  keyDocuments  String   @default("[]") // JSON array of received-doc chips
  createdAt     DateTime @default(now())
  createdBy     String?

  documents     Document[]
  jobs          Job[]
  proposals     ProposedValue[]
  flags         Flag[]
  risks         RiskItem[]
  scoreEntries  ScoreEntry[]
  memoSections  MemoSection[]
  lboScenarios  LboScenario[]
  checklist     ChecklistItem[]
  crossChecks   CrossCheckEntry[]
  cohortSets    CohortDataset[]
  draws         FacilityDraw[]
  holdCoTests   HoldCoTest[]

  @@index([status])
}

// ---- Module C: documents & pipeline ----
model Document {
  id            String   @id @default(cuid())
  dealId        String?  // nullable -> also serves Artifact Library
  deal          Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  type          String?  // CIM | tax_return | customer_file | financials | NDA | transcript | other
  currentVersionId String?
  createdAt     DateTime @default(now())
  versions      DocumentVersion[]
  proposals     ProposedValue[]
}

model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sha256      String
  filename    String
  sizeBytes   Int
  pages       Int?
  storagePath String
  uploadedBy  String?
  uploadedAt  DateTime @default(now())
  citations   Citation[]
  @@index([sha256])
}

model Job {
  id         String   @id @default(cuid())
  dealId     String?
  deal       Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  documentId String?
  agent      String   // agent0 | agent1 | agent2 | agent3a | agent3b | agent4 | tax | cohort | calls | pattern
  status     String   @default("queued") // queued|running|needs_review|done|failed
  attempts   Int      @default(0)
  tokens     Int?
  costUsd    Float?
  error      String?
  rawOutput  String?  // attached on needs_review / schema-fail
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([status])
}

// Extraction writes *proposed* values, never canonical (Module C.4).
model ProposedValue {
  id          String   @id @default(cuid())
  dealId      String
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id])
  field       String   // canonical field path, e.g. "ebitdaM"
  value       String?  // JSON-encoded; null = unknown (never inferred, C.7)
  citationLocator String? // page | sheet_range | section | timestamp | file
  snippet     String?
  confidence  String?  // high | low | unclear
  status      String   @default("pending") // pending|accepted|rejected
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
}

model Citation {
  id             String   @id @default(cuid())
  docVersionId   String
  docVersion     DocumentVersion @relation(fields: [docVersionId], references: [id], onDelete: Cascade)
  locatorType    String   // page | sheet_range | section | timestamp | file
  locatorValue   String
}

model Flag {
  id       String @id @default(cuid())
  dealId   String
  deal     Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  severity String // Red | Yellow | Green
  status   String @default("Open") // Open | Watching | Cleared
  label    String?
}

model RiskItem {
  id        String  @id @default(cuid())
  dealId    String
  deal      Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  severity  String  // Red | Yellow | Green
  risk      String
  evidence  String?
  mitigant  String?
  owner     String?
  status    String  @default("Open") // Open | Watching | Cleared
}

model ScoreEntry {
  id        String @id @default(cuid())
  dealId    String
  deal      Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?  @relation(fields: [userId], references: [id])
  kind      String // quant | qual
  axis      String
  value     Float?
  rationale String?
}

model MemoSection {
  id            String   @id @default(cuid())
  dealId        String
  deal          Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  page          String   // exec | financials | thesis | ...
  version       Int      @default(1)
  model         String?
  promptVersion String?
  body          String?
  data          String?  // JSON structured data
  generatedAt   DateTime @default(now())
  @@unique([dealId, page, version])
}

model LboScenario {
  id          String  @id @default(cuid())
  dealId      String
  deal        Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  name        String  // Base | Bull | Bear
  assumptions String  // JSON incl. financing_source
  outputs     String? // JSON
  grids       String? // JSON sensitivity grids
  @@unique([dealId, name])
}

model ChecklistItem {
  id      String @id @default(cuid())
  dealId  String
  deal    Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  label   String
  status  String @default("Missing") // Missing | Requested | Received | Processed
}

model CrossCheckEntry {
  id        String  @id @default(cuid())
  dealId    String
  deal      Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  figure    String
  appearsAt String?
  method    String  // Extracted | Calculated | Manual
  source    String?
  status    String  @default("Unverified") // Consistent | Discrepancy | Unverified
  detail    String?
  resolution String?
}

model CohortDataset {
  id        String @id @default(cuid())
  dealId    String
  deal      Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  filename  String
  createdAt DateTime @default(now())
  rows      CustomerYearRevenue[]
}

model CustomerYearRevenue {
  id         String @id @default(cuid())
  datasetId  String
  dataset    CohortDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  customer   String
  year       Int
  revenue    Float
}

// ---- Module HC: HoldCo ----
model HoldCoFacility {
  id           String  @id @default(cuid())
  lender       String
  commitment   Float
  drawn        Float   @default(0)
  rateType     String  // fixed | floating
  indexName    String?
  spreadBps    Int?
  amortization String? // JSON schedule
  maturity     DateTime?
  covenants    String? // JSON (maxLeverage, minDSCR, ...)
  draws        FacilityDraw[]
}

model FacilityDraw {
  id         String   @id @default(cuid())
  facilityId String
  facility   HoldCoFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  dealId     String?
  deal       Deal?    @relation(fields: [dealId], references: [id])
  amount     Float
  date       DateTime @default(now())
}

model HoldCoTest {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  inputs    String   // JSON snapshot
  verdict   String   // pass | breach
  headroom  Float?
  testedBy  String?
  testedAt  DateTime @default(now())
}

// ---- Module F: Artifact Library ----
model ArtifactItem {
  id       String @id @default(cuid())
  title    String
  category String
  tags     String @default("[]")
  ownerId  String?
  status   String @default("Draft") // Draft | In review | Final
  notes    String?
  externalUrl String?
  createdAt DateTime @default(now())
  versions ArtifactVersion[]
}

model ArtifactVersion {
  id         String @id @default(cuid())
  artifactId String
  artifact   ArtifactItem @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  filename   String
  storagePath String
  uploadedBy String?
  uploadedAt DateTime @default(now())
}
