# ---- Database ----
# Local dev: a Postgres URL (Neon/Supabase/Vercel free tier all work).
# Production (Vercel): set automatically when you add the Vercel Postgres/Neon integration.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ---- Anthropic (server-side only — never expose to the browser, Module C.6) ----
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-5"

# ---- File storage ----
# Production (Vercel): set automatically when you add Vercel Blob. When present,
# uploaded documents go to Blob instead of local disk. Leave unset for local disk.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
