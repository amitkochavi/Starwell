# Local dev DB (SQLite). For Postgres/Vercel: postgresql://...
DATABASE_URL="file:./dev.db"
# Server-side only — never expose to the browser (Module C.6)
ANTHROPIC_API_KEY="sk-ant-..."
# Default extraction/analysis model (PRD C.6 names claude-sonnet-4-6; use a current id)
ANTHROPIC_MODEL="claude-sonnet-5"
